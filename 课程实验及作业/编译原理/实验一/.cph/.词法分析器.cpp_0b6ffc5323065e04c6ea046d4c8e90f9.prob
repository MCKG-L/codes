{"name":"Local: 词法分析器","url":"e:\\project\\C++vscode\\课程实验及作业\\编译原理\\实验一\\词法分析器.cpp","tests":[{"id":1745997333234,"input":"const a=10;\nvar b, c;\nprocedure p;\n    begin\n        c := b+a;\n    end;\nbegin\n    read(b);\n    while b#0 do\n    begin\n        call p;\n        write(c*c);\n        read(b)\n    end\nend.\n$","output":""}],"interactive":false,"memoryLimit":1024,"timeLimit":3000,"srcPath":"e:\\project\\C++vscode\\课程实验及作业\\编译原理\\实验一\\词法分析器.cpp","group":"local","local":true}